# Credenciales de IOL Inversiones (las mismas de la app/web de IOL)
# Copiá este archivo como .env y completá tus datos. NUNCA subas .env al repositorio.
IOL_USERNAME=
IOL_PASSWORD=

# ---------------------------------------------------------------------------
# Opcionales (valores por defecto entre paréntesis)
# ---------------------------------------------------------------------------
# Endpoint de la API REST v1 (https://api.iolinversiones.com)
IOL_BASE_URL=https://api.iolinversiones.com
# Tipo de asset y panel usados en el screener; si se dejan vacíos se autodetectan
IOL_ASSET_TYPE_CEDEARS=
IOL_ASSET_TYPE_STOCKS=
IOL_PANEL=general
# Plazo de liquidación: T0 (inmediato) o T1 (24 h)
IOL_TERM=T0

# Caché local
CEDEARS_SNAPSHOT_TTL=90
CEDEARS_BARS_TTL=21600
CEDEARS_FX_TTL=600

# Concurrencia al descargar históricos (bajar si IOL devuelve 429)
CEDEARS_MAX_WORKERS=6
IOL_TIMEOUT=20

# Modo sandbox: 1 = datos sintéticos solo para probar la interfaz (NO usar en producción)
CEDEARS_SANDBOX=0

# Fuentes complementarias de tipo de cambio (públicas y gratuitas)
CCL_URL=https://dolarapi.com/v1/dolares/contadoconliqui
CCL_HISTORY_URL=https://api.argentinadatos.com/v1/cotizaciones/dolares/contadoconliqui
